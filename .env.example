# Django Settings
DEBUG=True
SECRET_KEY=django-insecure-dev-key-change-in-production-12345678
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration
DATABASE_NAME=lms_nalanda_db
DATABASE_USER=lms_user
DATABASE_PASSWORD=lms_password
DATABASE_HOST=db
DATABASE_PORT=5432

# PostgreSQL Environment Variables (for docker-compose)
POSTGRES_DB=lms_nalanda_db
POSTGRES_USER=lms_user
POSTGRES_PASSWORD=lms_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Email Configuration (Console backend for lightweight setup)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Django Superuser (Auto-created on first run)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@noulms.com
DJANGO_SUPERUSER_PASSWORD=admin123

# Static and Media Files
STATIC_ROOT=/app/staticfiles
MEDIA_ROOT=/app/media

# Security Settings (Lightweight - for development)
SECURE_SSL_REDIRECT=False
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_BROWSER_XSS_FILTER=True
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Timezone
TIME_ZONE=Asia/Kolkata

# Language
LANGUAGE_CODE=en-us
